<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TestMauiFaisabilite_KronoGeo.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="viewmodels:TakePhotoViewModel"
             x:Class="TestMauiFaisabilite_KronoGeo.TakePhoto"
             Title="TakePhoto">
    <VerticalStackLayout>
        <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*,50">
            <toolkit:CameraView x:Name="Camera"  Grid.ColumnSpan="3" Grid.Row="0" IsVisible="{Binding DisabledPhoto}"/>
            <Image Grid.ColumnSpan="3" Grid.Row="1" Source="{Binding Photo}" IsVisible="{Binding DisabledViewPhoto}"></Image>
            <HorizontalStackLayout Grid.Column="0" Grid.Row="2">
                <ImageButton Command="{Binding TakePhotoCommand}">
                    <ImageButton.Source>
                        <FontImageSource FontFamily="MaterialIcons-Regular" Glyph="&#xe412;"/>
                    </ImageButton.Source>
                </ImageButton>
            </HorizontalStackLayout>
        </Grid>
    </VerticalStackLayout>
</ContentPage>